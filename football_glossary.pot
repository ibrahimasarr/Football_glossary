import re
import polib

def analyser_glossaire_pulaar(fichier_po):
try: # Charger le fichier de traduction (.po ou .pot)
po = polib.pofile(fichier_po)
except Exception as e:
print(f"❌ Erreur lors du chargement du fichier : {e}")
return

    mots_emprunts_detectes = 0
    total_traduit = 0

    # Dictionnaire pour classer vos termes par classe nominale pulaar
    classes_nominales = {
        'ngal': [], 'ka': [], 'ɗam': [], 'o': [], 'ɗi': [],
        'ɗe': [], 'ko': [], 'ki': [], 'nde': [], 'ndu': [], 'Incertain': []
    }

    print("=" * 60)
    print(f"📊 ANALYSE DU GLOSSAIRE PULAAR : {fichier_po}")
    print("=" * 60)

    for entry in po:
        # Ignorer les entrées non encore traduites
        if not entry.msgstr or entry.msgstr.strip() == "":
            continue

        total_traduit += 1
        traduction_pulaar = entry.msgstr.strip().lower()
        terme_anglais = entry.msgid.strip().lower()

        # Récupérer le contexte français dans les commentaires de développement
        commentaire_fr = ""
        if entry.comment:
            match = re.search(r"french:\s*(.*)", entry.comment, re.IGNORECASE)
            if match:
                commentaire_fr = match.group(1).strip().lower()

        # 1. VÉRIFICATION DES EMPRUNTS ACCIDENTELS
        # On cherche si un mot anglais ou français complet s'est glissé dans la traduction pulaar
        mots_anglais = set(re.findall(r'\b\w+\b', terme_anglais))
        mots_francais = set(re.findall(r'\b\w+\b', commentaire_fr)) if commentaire_fr else set()
        mots_pulaar = set(re.findall(r'\b\w+\b', traduction_pulaar))

        # Intersection pour trouver les coupables (on ignore les mots ultra-courts de moins de 3 lettres)
        emprunts = (mots_pulaar.intersection(mots_anglais) | mots_pulaar.intersection(mots_francais))
        emprunts_filtrés = {m for m in emprunts if len(m) > 2}

        if emprunts_filtrés:
            mots_emprunts_detectes += 1
            print(f"⚠️ Alerte Emprunt sur ID '{entry.msgid}':")
            print(f"   - Pulaar: '{entry.msgstr}'")
            print(f"   - Mots suspects détectés: {list(emprunts_filtrés)}")
            print("-" * 40)

        # 2. CLASSIFICATION GRAMMATICALE AUTOMATIQUE
        # Détection basique du suffixe de classe en fin de mot
        classe_trouvee = False
        for classe in classes_nominales.keys():
            if classe != 'Incertain' and traduction_pulaar.endswith(classe):
                classes_nominales[classe].append(entry.msgstr)
                classe_trouvee = True
                break

        if not classe_trouvee:
            classes_nominales['Incertain'].append(entry.msgstr)

    # AFFICHAGE DU RAPPORT FINAL
    print("\n" + "=" * 60)
    print("📈 RAPPORT DE CONFORMITÉ LINGUISTIQUE")
    print("=" * 60)
    print(f"✅ Total de termes traduits analysés : {total_traduit}")
    print(f"🚨 Total d'alertes " + ("ZÉRO ! Parfait." if mots_emprunts_detectes == 0 else f": {mots_emprunts_detectes} entrées à corriger."))

    print("\n📦 RÉPARTITION ESTIMÉE PAR CLASSES NOMINALES (PULAAR):")
    for cl, termes in classes_nominales.items():
        if termes:
            print(f"  • Classe [{cl}] ({len(termes)} termes) : {', '.join(termes[:5])}" + ("..." if len(termes) > 5 else ""))

# Pour lancer le script, remplacez le nom du fichier par votre fichier .po traduit

if **name** == "**main**":
analyser_glossaire_pulaar("football_glossary_transfers.pot")

